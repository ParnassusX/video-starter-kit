// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  
  // User's API keys for external services
  apiKeys ApiKey[]
  
  // User's projects
  projects Project[]
  
  // Usage tracking
  usage Usage[]
  
  // Subscription/Billing info
  subscription Subscription?
}

model ApiKey {
  id        String   @id @default(cuid())
  name      String
  provider  String   // fal, replicate, bytedance
  apiKey    String   @db.Text // Encrypted
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, provider])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  aspectRatio String   @default("16:9")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Project's media items
  mediaItems MediaItem[]
  
  // Project's tracks
  tracks Track[]
  
  // Project's keyframes
  keyFrames KeyFrame[]
  
  // Sharing settings
  shares ProjectShare[]
}

model MediaItem {
  id          String   @id @default(cuid())
  projectId   String
  mediaType   String   // image, video, music, voiceover
  kind        String   // generated, uploaded
  endpointId  String?  // AI model endpoint used
  requestId   String?  // Request ID from AI provider
  status      String   // pending, running, completed, failed
  url         String?  // URL to the media file
  input       Json?    // Input parameters for generation
  output      Json?    // Output from AI provider
  metadata    Json?    // Additional metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Keyframes that reference this media
  keyFrames KeyFrame[]
}

model Track {
  id        String   @id @default(cuid())
  projectId String
  locked    Boolean  @default(false)
  label     String
  type      String   // video, music, voiceover
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Keyframes in this track
  keyFrames KeyFrame[]
}

model KeyFrame {
  id        String   @id @default(cuid())
  timestamp Float
  duration  Float
  trackId   String
  data      Json     // KeyFrameData
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  track    Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  project  Project   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  mediaItem MediaItem? @relation(fields: [data], references: [id])
}

model ProjectShare {
  id        String   @id @default(cuid())
  projectId String
  shareId   String   @unique // Public share ID
  createdAt DateTime @default(now())
  expiresAt DateTime?
  
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Usage {
  id          String   @id @default(cuid())
  userId      String
  provider    String   // fal, replicate, bytedance
  model       String   // Model used
  cost        Float    // Cost in USD
  tokens      Int?     // Tokens used (if applicable)
  metadata    Json?    // Additional usage metadata
  createdAt   DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String   @unique
  plan        String   // free, pro, enterprise
  status      String   // active, canceled, past_due
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}